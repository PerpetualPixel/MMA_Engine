# Copy to .env and fill in. .env is gitignored — never commit the real key.
#   cp .env.example .env

# Required: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Required for channel discovery (free — YouTube's RSS feeds are discontinued).
# Google Cloud console -> create project -> enable "YouTube Data API v3"
# -> Credentials -> Create credentials -> API key. No billing needed.
YOUTUBE_API_KEY=AIza...

# Optional overrides (defaults shown; config.json "settings" also sets these)
# MMA_MODEL=claude-opus-5
# MMA_EFFORT=high
