# Secrets — never commit these
.env
.env.*
!.env.example
# Exported YouTube cookies for the age-restricted transcript fallback — a live
# session token, every bit as sensitive as an API key.
cookies.txt

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
test_env/
.pytest_cache/

# Pipeline artifacts
cache/
*.log
# --roster-from's default review output. Regenerated locally by every run
# (see pipeline.py's --roster-output default) — never meant to be tracked.
# One got committed by mistake in #36; that instance is history now, this
# stops the next one from colliding with a `git pull` the way it just did.
roster_proposal.json

# Picks pasted from paywalled posts (Patreon and the like). Someone else's
# paid writing — ours to read locally, never ours to publish. The folder and
# its README stay tracked so the instructions travel with the repo; nothing
# dropped into it does.
pasted/*
!pasted/README.md

# OS / editor
.DS_Store
.idea/
.vscode/
